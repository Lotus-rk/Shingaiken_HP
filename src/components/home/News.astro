---
// 研究会のお知らせ（新しい順に 5 件）
import EventList from '../EventList.astro';
import { withBase } from '../../lib/url';
import type { EventEntry } from '../../lib/events';

interface Props {
  events: EventEntry[];
}
const { events } = Astro.props;
---

<section class="section news" aria-labelledby="news-title">
  <div class="container">
    <div class="news__head">
      <h2 class="section-title" id="news-title">研究会のお知らせ</h2>
      <a class="text-link news__all" href={withBase('/events/')}>一覧を見る ›</a>
    </div>
    {
      events.length > 0 ? (
        <EventList events={events} label="研究会のお知らせ（新しい順）" />
      ) : (
        <p>お知らせはまだありません。</p>
      )
    }
  </div>
</section>

<style>
  .news__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px 16px;
    margin-bottom: 8px;
  }
  .news__head .section-title {
    margin-bottom: 16px;
  }
  .news__all {
    padding: 6px 0;
  }
</style>
