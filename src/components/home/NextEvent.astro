---
// 次回の研究会（淡い黄色の枠）。予定がないときも同じ枠で「準備中」を出す。
import { site } from '../../data/site';
import { withBase } from '../../lib/url';
import { eventPath, formatDateTimeRange, formatFee, formatLabel, jstParts, toJstIso, type EventEntry } from '../../lib/events';

interface Props {
  event?: EventEntry;
}
const { event } = Astro.props;

const p = event ? jstParts(event.data.start) : undefined;
const place = event
  ? event.data.venue === formatLabel(event)
    ? event.data.venue
    : `${formatLabel(event)}（${event.data.venue}）`
  : undefined;
const fee = event ? formatFee(event.data.fee) : undefined;
---

<section class="next" id="next" aria-labelledby="next-label">
  <div class="container">
    <div class="next__box">
      {
        event && p ? (
          <>
            <p class="next__date" aria-hidden="true">
              <span class="next__month">{p.month}月</span>
              <span class="next__day">{p.day}</span>
              <span class="next__weekday">{p.weekday}曜日</span>
            </p>
            <div class="next__body">
              <h2 class="next__label" id="next-label">次回の研究会</h2>
              <h3 class="next__title">
                <a href={withBase(eventPath(event))}>{event.data.title}</a>
              </h3>
              {event.data.subtitle && <p class="next__subtitle">{event.data.subtitle}</p>}
              <dl class="next__meta">
                <div>
                  <dt>日時</dt>
                  <dd>
                    <time datetime={toJstIso(event.data.start)}>{formatDateTimeRange(event.data.start, event.data.end)}</time>
                  </dd>
                </div>
                <div>
                  <dt>形式</dt>
                  <dd>{place}</dd>
                </div>
                {fee && (
                  <div>
                    <dt>参加費</dt>
                    <dd>{fee}</dd>
                  </div>
                )}
              </dl>
              <p class="next__more">
                <a class="text-link" href={withBase(eventPath(event))}>詳しい内容を見る ›</a>
              </p>
            </div>
            {event.data.apply && (
              <p class="next__apply">
                <a class="button button--primary" href={event.data.apply}>Peatixで申し込む</a>
              </p>
            )}
          </>
        ) : (
          <div class="next__body">
            <h2 class="next__label" id="next-label">次回の研究会</h2>
            <p class="next__empty">次回の研究会は準備中です。決まり次第、このサイトとSNSでお知らせします。</p>
            <p class="next__links">
              <a class="text-link" href={site.sns.instagram}>Instagram</a>
              <a class="text-link" href={site.sns.x}>X</a>
              <a class="text-link" href={withBase('/events/#past-title')}>過去の研究会を見る ›</a>
            </p>
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  .next {
    padding: 56px 0 0;
  }
  .next__box {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 24px 32px;
    padding: 32px;
    background: var(--color-next-bg);
    border-radius: var(--radius-box);
  }
  .next__date {
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 112px;
    height: 112px;
    margin: 0;
    background: #fff;
    border-radius: 12px;
    line-height: 1.2;
    text-align: center;
  }
  .next__month,
  .next__weekday {
    font-size: 13px;
    font-weight: 700;
    color: var(--color-next-label);
  }
  .next__day {
    font-family: var(--font-heading);
    font-size: 42px;
    font-weight: 700;
    color: var(--color-text);
  }
  .next__body {
    flex: 1 1 420px;
    min-width: 0;
  }
  .next__label {
    margin: 0 0 4px;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--color-next-label);
  }
  .next__title {
    margin: 0 0 8px;
    font-size: 24px;
    line-height: 1.55;
  }
  .next__title a {
    color: var(--color-text);
    text-decoration: none;
  }
  .next__title a:hover {
    color: var(--color-main-hover);
    text-decoration: underline;
  }
  .next__subtitle {
    margin: 0 0 8px;
    color: var(--color-text-sub);
  }
  .next__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 24px;
    margin: 0 0 8px;
    font-size: 15px;
    color: var(--color-text-sub);
  }
  .next__meta div {
    display: flex;
    gap: 8px;
  }
  .next__meta dt {
    font-weight: 700;
    color: var(--color-next-label);
  }
  .next__meta dd {
    margin: 0;
  }
  .next__more,
  .next__apply {
    margin: 0;
  }
  .next__apply {
    flex: 0 0 auto;
  }
  .next__apply .button {
    padding: 14px 28px;
  }
  .next__empty {
    margin: 4px 0 12px;
    font-size: 17px;
    color: var(--color-text);
  }
  .next__links {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 24px;
    margin: 0;
  }
  @media (max-width: 640px) {
    .next {
      padding-top: 36px;
    }
    .next__box {
      padding: 24px 20px;
      gap: 16px;
    }
    .next__date {
      width: 88px;
      height: 88px;
    }
    .next__day {
      font-size: 34px;
    }
    .next__body {
      flex-basis: 100%;
    }
    .next__title {
      font-size: 20px;
    }
    .next__meta {
      flex-direction: column;
    }
    .next__apply {
      flex: 1 1 100%;
    }
    .next__apply .button {
      display: block;
      text-align: center;
    }
  }
</style>
