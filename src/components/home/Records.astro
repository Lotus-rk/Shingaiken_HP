---
// トップの「研究会の記録」：開催日を過ぎた研究会を新しい順に並べる（9 件以上あれば新しい 8 件）。
// 見出しの下に、発足からの回数（ビルド時に数える）を添える。
import EventList from '../EventList.astro';
import { site } from '../../data/site';
import { withBase } from '../../lib/url';
import type { EventEntry } from '../../lib/events';

interface Props {
  /** 開催日を過ぎた研究会（新しい順） */
  events: EventEntry[];
}
const { events } = Astro.props;
/** トップに出す件数の上限。全件は研究会一覧ページで見られる */
const LIMIT = 8;
---

<section class="records" id="records" aria-labelledby="records-title">
  <h2 class="section-title" id="records-title">研究会の記録</h2>
  {
    events.length > 0 ? (
      <>
        <p class="records__note">{site.foundedLabel}の発足から、{events.length}回の研究会を開きました。</p>
        <EventList events={events.slice(0, LIMIT)} label="研究会の記録（新しい順）" />
      </>
    ) : (
      <p>まだありません。</p>
    )
  }
  <p class="records__all">
    <a class="text-link" href={withBase('/events/')}>研究会の一覧へ <span aria-hidden="true">›</span></a>
  </p>
</section>

<style>
  .records__note {
    margin: -4px 0 12px;
    font-size: 14px;
    color: var(--color-text-note);
  }
  .records__all {
    margin: 12px 0 0;
    text-align: right;
  }
</style>
