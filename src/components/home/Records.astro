---
// トップの「研究会の記録」：開催日を過ぎた研究会を新しい順に並べる（9 件以上あれば新しい 8 件）。
// 見出しの下に、発足からの回数（ビルド時に数える）を添える。全件は研究会一覧ページにある。
import EventList from '../EventList.astro';
import { site } from '../../data/site';
import { withBase } from '../../lib/url';
import type { EventEntry } from '../../lib/events';

interface Props {
  /** 開催日を過ぎた研究会（新しい順） */
  events: EventEntry[];
}
const { events } = Astro.props;
/** トップに出す件数の上限 */
const LIMIT = 8;
---

<section class="section records" id="records" aria-labelledby="records-title">
  <div class="container">
    <div class="records__head">
      <h2 class="section-title" id="records-title">研究会の記録</h2>
      <a class="text-link records__all" href={withBase('/events/')}>研究会の一覧へ <span aria-hidden="true">›</span></a>
    </div>
    {
      events.length > 0 ? (
        <>
          <p class="records__note">{site.foundedLabel}の発足から、{events.length}回の研究会を開きました。</p>
          <EventList events={events.slice(0, LIMIT)} label="研究会の記録（新しい順）" />
        </>
      ) : (
        <p>まだありません。</p>
      )
    }
  </div>
</section>

<style>
  .records__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px 16px;
  }
  .records__head .section-title {
    margin-bottom: 16px;
  }
  .records__all {
    padding: 6px 0;
  }
  .records__note {
    margin: 0 0 16px;
    color: var(--color-text-sub);
  }
</style>
