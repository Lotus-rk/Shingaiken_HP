---
// 新外研について（淡い水色）。発足と活動の説明、大切にしていること 3 項目。
import { site } from '../../data/site';
import { withBase } from '../../lib/url';

// 仮：3 項目の文言は代表の確認待ち（CLAUDE.md §4「新外研が大切にしていること」）
const points = [
  {
    title: '授業づくりから考える',
    text: '子どもの言語能力を伸ばす授業のあり方を、実際の授業に即して検討します。',
  },
  {
    title: '実践と研究をつなぐ',
    text: '教室での実践と学術的な研究を行き来しながら、教師の専門性と教育の質を高めます。',
  },
  {
    title: '授業を公開し、学び合う',
    text: '公開授業研究会やオンラインの検討会で、授業を見て語り合います。',
  },
];
---

<section class="section section--tint about" aria-labelledby="about-title">
  <div class="container">
    <h2 class="section-title" id="about-title">新外研について</h2>
    <p class="about__lead">
      {site.shortName}は{site.foundedLabel}に発足しました。これまでに、公開授業研究会（東京学芸大学附属世田谷小学校）、オンライン授業検討会、大学院生が企画した「新外研 Students」、オンラインセミナーを開きました。
    </p>
    {/* 仮：以下の 3 項目は代表の確認待ち */}
    <ul class="about__points">
      {
        points.map((pt) => (
          <li>
            <h3>{pt.title}</h3>
            <p>{pt.text}</p>
          </li>
        ))
      }
    </ul>
    <p class="about__more">
      <a class="text-link" href={withBase('/about/')}>会の目的・会則を見る ›</a>
    </p>
  </div>
</section>

<style>
  .about__lead {
    max-width: 46em;
    margin: 0 0 36px;
    color: var(--color-text-sub);
  }
  .about__points {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr));
    gap: 28px 40px;
    margin: 0 0 32px;
    padding: 0;
    list-style: none;
  }
  .about__points li {
    padding-top: 16px;
    border-top: 2px solid var(--color-main);
  }
  .about__points h3 {
    margin: 0 0 8px;
    font-size: 19px;
    color: var(--color-main);
  }
  .about__points p {
    margin: 0;
    color: var(--color-text-sub);
  }
  .about__more {
    margin: 0;
  }
</style>
