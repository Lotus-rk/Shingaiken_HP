---
// 研究会ページの「開催情報」の箱に入れる表（日時・形式・会場・参加費・申込・登壇者）。項目があるものだけを出す。
import { formatDateTimeRange, formatFee, formatLabel, type EventEntry } from '../../lib/events';

interface Props {
  entry: EventEntry;
  /** これからの研究会なら true（申込欄の表示が変わる） */
  upcoming: boolean;
}
const { entry, upcoming } = Astro.props;
const d = entry.data;
const fee = formatFee(d.fee);
---

<dl class="facts">
  <div class="facts__row">
    <dt>日時</dt>
    <dd>{formatDateTimeRange(d.start, d.end)}</dd>
  </div>
  <div class="facts__row">
    <dt>形式</dt>
    <dd>{formatLabel(entry)}</dd>
  </div>
  <div class="facts__row">
    <dt>会場</dt>
    <dd>
      {d.venue}
      {d.venueAddress && <span class="facts__note">{d.venueAddress}</span>}
    </dd>
  </div>
  {
    fee && (
      <div class="facts__row">
        <dt>参加費</dt>
        <dd>{fee}</dd>
      </div>
    )
  }
  {
    d.apply && (
      <div class="facts__row">
        <dt>申込</dt>
        <dd>
          {/* 受付中は箱の上に「Peatix で申し込む」ボタンがあるので、同じリンクを二つ並べない */}
          {upcoming ? 'Peatix（上のボタンから）' : '受付は終了しました'}
        </dd>
      </div>
    )
  }
  {
    d.speakers.length > 0 && (
      <div class="facts__row">
        <dt>登壇者</dt>
        <dd>
          <ul class="facts__speakers">
            {d.speakers.map((s) => (
              <li>
                {s.role && <span class="facts__role">{s.role}</span>}
                {s.name}
                {s.affiliation && `（${s.affiliation}）`}
              </li>
            ))}
          </ul>
        </dd>
      </div>
    )
  }
</dl>

<style>
  /* 開催情報の箱の中の表：左に項目名、行の間に細い罫線 */
  .facts {
    margin: 0;
  }
  .facts__row {
    display: grid;
    grid-template-columns: 4.5em minmax(0, 1fr);
    gap: 4px 10px;
    padding: 9px 2px;
    border-bottom: 1px solid var(--color-line);
  }
  .facts__row:last-child {
    border-bottom: 0;
  }
  dt {
    font-weight: 700;
    color: var(--color-text-sub);
  }
  dd {
    margin: 0;
  }
  .facts__note {
    display: block;
    font-size: 13px;
    color: var(--color-text-note);
  }
  .facts__speakers {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .facts__speakers li + li {
    margin-top: 6px;
  }
  .facts__role {
    display: block;
    font-size: 13px;
    line-height: 1.5;
    color: var(--color-text-note);
  }
</style>
