---
// 下層ページの見出し：パンくず（ホーム › ページ名）と h1。パンくずは白地の細い行、h1 は淡い水色の帯に置く。
// 研究会の個別ページ以外の下層ページは、すべてこれを使う。
import Breadcrumbs, { type Crumb } from './Breadcrumbs.astro';

export interface Props {
  title: string;
  /** ホームと今のページの間に挟む階層。省略すると「ホーム › title」 */
  breadcrumbs?: Crumb[];
  /** 見出しの下に置く短い説明（任意） */
  lead?: string;
}

const { title, breadcrumbs = [], lead } = Astro.props;
---

<div class="page-header">
  <Breadcrumbs items={[...breadcrumbs, { label: title }]} />
  <div class="page-header__band">
    <div class="container">
      <h1 class="page-title">{title}</h1>
      {lead && <p class="page-header__lead">{lead}</p>}
    </div>
  </div>
</div>

<style>
  .page-header__band {
    background: var(--color-bg-tint);
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
    padding: 22px 0 24px;
  }
  .page-header__lead {
    margin: 10px 0 0;
    max-width: var(--width-text);
    color: var(--color-text-sub);
    font-size: 15px;
  }
  @media (max-width: 640px) {
    .page-header__band {
      padding: 16px 0 18px;
    }
  }
</style>
