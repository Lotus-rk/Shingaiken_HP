---
// 次回の研究会のお知らせ（淡い黄色の枠に、年・月日・曜日の日付札を添える）。トップと研究会一覧で共用。
// 予定がないときも同じ枠で「準備中」を出す。予定が 2 件以上あるときは、2 件目以降を枠の下の方に短く並べる。
import { site } from '../data/site';
import { withBase } from '../lib/url';
import EventList from './EventList.astro';
import { eventPath, formatDateTimeRange, formatFee, formatLabel, jstParts, kindOf, toJstIso, type EventEntry } from '../lib/events';

interface Props {
  /** これからの研究会（開催日の早い順）。先頭を大きく出す */
  events: EventEntry[];
  /** 枠の上の見出し */
  title?: string;
  /** 見出しの id（ページ内リンク用） */
  headingId?: string;
  /** 2 件目以降の小見出し */
  othersTitle?: string;
  /** 準備中のときに添える、過去の研究会へのリンク */
  pastLink?: { href: string; label: string };
}
const {
  events,
  title = '次回の研究会',
  headingId = 'next-title',
  othersTitle = 'これからの研究会',
  pastLink = { href: '/events/#past-title', label: '過去の研究会' },
} = Astro.props;

const event = events[0];
const others = events.slice(1);
const p = event ? jstParts(event.data.start) : undefined;
const place = event
  ? event.data.venue === formatLabel(event)
    ? event.data.venue
    : `${formatLabel(event)}（${event.data.venue}）`
  : undefined;
const fee = event ? formatFee(event.data.fee) : undefined;
const kind = event ? kindOf(event) : undefined;
---

<section class="next" aria-labelledby={headingId}>
  <h2 class="section-title" id={headingId}>{title}</h2>
  <div class="next__box">
    {
      event && p && kind ? (
        <>
          <div class="next__grid">
            {/* 日付札。読み上げでは下の「日時」を読むので、ここは隠す */}
            <p class="next__stamp" aria-hidden="true">
              <span class="next__stamp-year">{p.year}</span>
              <span class="next__stamp-md">
                {p.month}<small>月</small>{p.day}<small>日</small>
              </span>
              <span class="next__stamp-wd">{p.weekday}曜日</span>
            </p>
            <div class="next__body">
              <p class="next__kind">
                <span class={`kind ${kind.className}`}>{kind.label}</span>
              </p>
              <h3 class="next__title">
                <a href={withBase(eventPath(event))}>{event.data.title}</a>
              </h3>
              {event.data.subtitle && <p class="next__subtitle">{event.data.subtitle}</p>}
              <dl class="next__meta">
                <div>
                  <dt>日時</dt>
                  <dd>
                    <time datetime={toJstIso(event.data.start)}>{formatDateTimeRange(event.data.start, event.data.end)}</time>
                  </dd>
                </div>
                <div>
                  <dt>形式</dt>
                  <dd>{place}</dd>
                </div>
                {fee && (
                  <div>
                    <dt>参加費</dt>
                    <dd>{fee}</dd>
                  </div>
                )}
              </dl>
              <p class="next__actions">
                {event.data.apply && (
                  <a class="button button--primary" href={event.data.apply} rel="noopener">
                    Peatixで申し込む
                  </a>
                )}
                <a class="text-link" href={withBase(eventPath(event))}>詳しい内容 <span aria-hidden="true">›</span></a>
              </p>
            </div>
          </div>
          {others.length > 0 && (
            <div class="next__others">
              <h3 class="next__others-title">{othersTitle}</h3>
              <EventList events={others} label={othersTitle} />
            </div>
          )}
        </>
      ) : (
        <>
          <p class="next__empty">次回の研究会は準備中です。決まり次第、このサイトとSNSでお知らせします。</p>
          <p class="next__links">
            <a class="text-link" href={site.sns.instagram} rel="noopener">Instagram</a>
            <a class="text-link" href={site.sns.x} rel="noopener">X</a>
            <a class="text-link" href={withBase(pastLink.href)}>{pastLink.label} <span aria-hidden="true">›</span></a>
          </p>
        </>
      )
    }
  </div>
</section>

<style>
  .next__box {
    padding: 20px 24px;
    background: var(--color-next-bg);
    border: 1px solid var(--color-next-line);
    border-top: 4px solid #e3b84a;
  }
  .next__grid {
    display: grid;
    grid-template-columns: 108px minmax(0, 1fr);
    gap: 16px 22px;
    align-items: start;
  }
  /* 日付札：上に年の帯、中央に月日、下に曜日 */
  .next__stamp {
    display: flex;
    flex-direction: column;
    margin: 4px 0 0;
    background: #fff;
    border: 1px solid var(--color-next-line);
    text-align: center;
    line-height: 1.2;
  }
  .next__stamp-year {
    padding: 3px 0;
    background: var(--color-next-label);
    color: #fff;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
  }
  .next__stamp-md {
    padding: 8px 0 4px;
    font-size: 23px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: var(--color-text);
    white-space: nowrap;
  }
  .next__stamp-md small {
    margin: 0 1px;
    font-size: 12px;
    font-weight: 500;
  }
  .next__stamp-wd {
    padding: 0 0 7px;
    font-size: 13px;
    font-weight: 700;
    color: var(--color-next-label);
  }
  .next__body {
    min-width: 0;
  }
  .next__kind {
    margin: 0 0 4px;
  }
  .next__title {
    margin: 0 0 4px;
    font-size: 21px;
    line-height: 1.55;
  }
  .next__title a {
    color: var(--color-text);
    text-decoration: none;
  }
  .next__title a:hover {
    color: var(--color-main-hover);
    text-decoration: underline;
  }
  .next__subtitle {
    margin: 0 0 4px;
    color: var(--color-text-sub);
  }
  /* 日時・形式などは表のように左に項目名をそろえる */
  .next__meta {
    margin: 12px 0 16px;
    border-top: 1px solid var(--color-next-line);
    font-size: 15px;
  }
  .next__meta div {
    display: grid;
    grid-template-columns: 4.5em 1fr;
    gap: 12px;
    padding: 6px 0;
    border-bottom: 1px solid var(--color-next-line);
  }
  .next__meta dt {
    font-weight: 700;
    color: var(--color-next-label);
  }
  .next__meta dd {
    margin: 0;
  }
  .next__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 24px;
    margin: 0;
  }
  /* 2 件目以降の予定 */
  .next__others {
    margin-top: 20px;
    padding-top: 12px;
    border-top: 1px solid var(--color-next-line);
  }
  .next__others-title {
    margin: 0 0 8px;
    font-size: 15px;
    color: var(--color-next-label);
  }
  .next__others :global(.event-list) {
    border-top: 0;
  }
  .next__others :global(.event-list li) {
    border-color: var(--color-next-line);
  }
  .next__empty {
    margin: 0 0 8px;
  }
  .next__links {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 24px;
    margin: 0;
  }
  @media (max-width: 640px) {
    .next__box {
      padding: 16px;
    }
    .next__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 12px;
    }
    /* 狭い画面では日付札を横長にする */
    .next__stamp {
      flex-direction: row;
      align-items: stretch;
      justify-self: start;
      margin: 0;
    }
    .next__stamp-year {
      display: flex;
      align-items: center;
      padding: 0 10px;
    }
    .next__stamp-md {
      padding: 4px 12px;
      font-size: 20px;
    }
    .next__stamp-wd {
      display: flex;
      align-items: center;
      padding: 0 12px 0 0;
    }
    .next__title {
      font-size: 18px;
    }
    .next__actions .button {
      flex: 1 1 100%;
      text-align: center;
    }
  }
</style>
