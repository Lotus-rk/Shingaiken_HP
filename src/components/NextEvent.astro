---
// 次回の研究会のお知らせ（淡い黄色の枠に、年・月日・曜日の日付札を添える）。トップと研究会一覧で共用。
// 予定がないときも同じ枠で「準備中」を出す。予定が 2 件以上あるときは、2 件目以降を枠の下の方に短く並べる。
// 見出しは、トップでは枠の中の小さな見出し（labelInside）、研究会一覧ではほかの節と同じ下線付きの見出しにする。
import { site } from '../data/site';
import { withBase } from '../lib/url';
import EventList from './EventList.astro';
import { dateTimeRangeParts, eventPath, formatFee, formatLabel, jstParts, kindOf, toJstIso, type EventEntry } from '../lib/events';

interface Props {
  /** これからの研究会（開催日の早い順）。先頭を大きく出す */
  events: EventEntry[];
  /** 見出し */
  title?: string;
  /** 見出しの id */
  headingId?: string;
  /** 枠全体の id（ページ内リンク用。例：トップの「次回の研究会」ボタンの行き先） */
  id?: string;
  /** true なら見出しを枠の中に小さく置く（トップ用） */
  labelInside?: boolean;
  /** 2 件目以降の小見出し */
  othersTitle?: string;
  /** 準備中のときに添える、過去の研究会へのリンク。null なら出さない（すぐ下に記録が続くトップ用） */
  pastLink?: { href: string; label: string } | null;
}
const {
  events,
  title = '次回の研究会',
  headingId = 'next-title',
  id,
  labelInside = false,
  othersTitle = 'その後の予定',
  pastLink = { href: '/events/#past-title', label: '過去の研究会を見る' },
} = Astro.props;

const event = events[0];
const others = events.slice(1);
const p = event ? jstParts(event.data.start) : undefined;
const place = event
  ? event.data.venue === formatLabel(event)
    ? event.data.venue
    : `${formatLabel(event)}（${event.data.venue}）`
  : undefined;
const fee = event ? formatFee(event.data.fee) : undefined;
const kind = event ? kindOf(event) : undefined;
const othersId = `${headingId}-others`;
---

<section class="next" id={id} aria-labelledby={headingId}>
  {!labelInside && <h2 class="section-title" id={headingId}>{title}</h2>}
  <div class="next__box">
    {labelInside && <h2 class="next__label" id={headingId}>{title}</h2>}
    {
      event && p && kind ? (
        <>
          {/* 並び（HTML の順のまま）：日付札・種別と題名・日時などの表・申込ボタン。広い画面では札を左、ボタンを右に置く */}
          <div class="next__main">
            {/* 日付札。読み上げでは下の「日時」を読むので、ここは隠す */}
            <p class="next__stamp" aria-hidden="true">
              <span class="next__stamp-year">{p.year}</span>
              <span class="next__stamp-md">
                {p.month}<small>月</small>{p.day}<small>日</small>
              </span>
              <span class="next__stamp-wd">{p.weekday}曜日</span>
            </p>
            <div class="next__head">
              <p class="next__kind">
                <span class={`kind ${kind.className}`}>{kind.label}</span>
              </p>
              <h3 class="next__title">
                <a href={withBase(eventPath(event))}>{event.data.title}</a>
              </h3>
              {event.data.subtitle && <p class="next__subtitle">{event.data.subtitle}</p>}
            </div>
            <div class="next__details">
              <dl class="next__meta">
                <div>
                  <dt>日時</dt>
                  <dd>
                    <time datetime={toJstIso(event.data.start)}>
                      {dateTimeRangeParts(event.data.start, event.data.end).map((part, i) => (
                        <>
                          {i > 0 && ' '}
                          <span class="nowrap">{part}</span>
                        </>
                      ))}
                    </time>
                  </dd>
                </div>
                <div>
                  <dt>形式</dt>
                  <dd>{place}</dd>
                </div>
                {fee && (
                  <div>
                    <dt>参加費</dt>
                    <dd>{fee}</dd>
                  </div>
                )}
              </dl>
              <p class="next__more">
                <a class="text-link" href={withBase(eventPath(event))}>詳しい内容を見る <span aria-hidden="true">›</span></a>
              </p>
            </div>
            {event.data.apply && (
              <p class="next__apply">
                <a class="button button--primary" href={event.data.apply} rel="noopener">Peatixで申し込む</a>
              </p>
            )}
          </div>
          {others.length > 0 && (
            <div class="next__others">
              <h3 class="next__others-title" id={othersId}>{othersTitle}</h3>
              <EventList events={others} labelledby={othersId} />
            </div>
          )}
        </>
      ) : (
        <div class="next__empty-body">
          <p class="next__empty">次回の研究会は準備中です。決まり次第、このサイトとSNSでお知らせします。</p>
          <p class="next__links">
            <a class="text-link" href={site.sns.instagram} rel="noopener">Instagram</a>
            <a class="text-link" href={site.sns.x} rel="noopener">X</a>
            {pastLink && (
              <a class="text-link" href={withBase(pastLink.href)}>{pastLink.label} <span aria-hidden="true">›</span></a>
            )}
          </p>
        </div>
      )
    }
  </div>
</section>

<style>
  .next__box {
    --next-line: #ecdba6;
    padding: 32px;
    background: var(--color-next-bg);
    border-radius: var(--radius-box);
  }
  /* 広い画面：左に日付札（2 行分）、中に題名と表、右に申込ボタン */
  .next__main {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    grid-template-areas:
      'stamp head apply'
      'stamp details apply';
    align-items: center;
    gap: 0 32px;
  }
  /* 日付札：白い角丸の札に、年・月日・曜日 */
  .next__stamp {
    grid-area: stamp;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 128px;
    min-height: 120px;
    margin: 0;
    padding: 12px 6px;
    background: #fff;
    border-radius: 12px;
    line-height: 1.25;
    text-align: center;
  }
  .next__stamp-year,
  .next__stamp-wd {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--color-next-label);
  }
  .next__stamp-md {
    margin: 4px 0;
    font-family: var(--font-heading);
    font-size: 30px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: var(--color-text);
    white-space: nowrap;
  }
  .next__stamp-md small {
    margin: 0 1px;
    font-size: 14px;
  }
  .next__head {
    grid-area: head;
    align-self: end;
    min-width: 0;
  }
  .next__details {
    grid-area: details;
    align-self: start;
    min-width: 0;
  }
  .next__label {
    margin: -8px 0 14px;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--color-next-label);
  }
  .next__kind {
    margin: 0 0 4px;
  }
  .next__title {
    margin: 0 0 8px;
    font-size: 24px;
    line-height: 1.55;
    line-break: strict;
  }
  .next__title a {
    color: var(--color-text);
    text-decoration: none;
  }
  .next__title a:hover {
    color: var(--color-main-hover);
    text-decoration: underline;
  }
  .next__subtitle {
    margin: 0 0 8px;
    color: var(--color-text-sub);
  }
  .next__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 24px;
    margin: 0 0 8px;
    font-size: 15px;
    color: var(--color-text-sub);
  }
  .next__meta div {
    display: flex;
    gap: 8px;
  }
  .next__meta dt {
    flex: 0 0 auto;
    font-weight: 700;
    color: var(--color-next-label);
  }
  .next__meta dd {
    margin: 0;
  }
  .next__more,
  .next__apply {
    margin: 0;
  }
  .next__apply {
    grid-area: apply;
  }
  .next__apply .button {
    padding: 14px 28px;
  }
  /* 2 件目以降の予定 */
  .next__others {
    margin-top: 24px;
    padding-top: 16px;
    border-top: 1px solid var(--next-line);
  }
  .next__others-title {
    margin: 0 0 4px;
    font-family: var(--font-body);
    font-size: 14px;
    letter-spacing: 0.04em;
    color: var(--color-next-label);
  }
  .next__others :global(.event-list) {
    border-top: 0;
  }
  .next__others :global(.event-list li) {
    border-color: var(--next-line);
  }
  .next__others :global(.event-list li:last-child) {
    border-bottom: 0;
  }
  .next__empty {
    margin: 0 0 12px;
    font-size: 17px;
    color: var(--color-text);
  }
  .next__links {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 24px;
    margin: 0;
  }
  /* 中くらいの画面：申込ボタンを下の行へ */
  @media (max-width: 900px) {
    .next__main {
      grid-template-columns: auto minmax(0, 1fr);
      grid-template-areas:
        'stamp head'
        'stamp details'
        'apply apply';
    }
    .next__apply {
      margin-top: 20px;
    }
  }
  /* スマートフォン：小さめの札の右に種別と題名。表とボタンは下に全幅で */
  @media (max-width: 640px) {
    .next__box {
      padding: 24px 20px;
    }
    .next__main {
      grid-template-columns: 84px minmax(0, 1fr);
      grid-template-areas:
        'stamp head'
        'details details'
        'apply apply';
      align-items: start;
      gap: 0 14px;
    }
    .next__stamp {
      width: 84px;
      min-height: 0;
      padding: 8px 2px;
      border-radius: 10px;
    }
    .next__stamp-year,
    .next__stamp-wd {
      font-size: 12px;
      letter-spacing: 0.02em;
    }
    .next__stamp-md {
      margin: 2px 0;
      font-size: 19px;
    }
    .next__stamp-md small {
      margin: 0;
      font-size: 11px;
    }
    .next__head {
      align-self: center;
    }
    .next__title {
      margin-bottom: 0;
      font-size: 19px;
    }
    .next__subtitle {
      margin: 6px 0 0;
      font-size: 15px;
    }
    .next__details {
      margin-top: 16px;
    }
    .next__meta {
      flex-direction: column;
    }
    .next__apply {
      margin-top: 16px;
    }
    .next__apply .button {
      display: block;
      text-align: center;
    }
  }
</style>
