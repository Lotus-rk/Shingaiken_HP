---
// 右の欄の「会の情報」の箱（会のページへのリンク集）。トップの右の欄と研究会の個別ページで共用。
import { withBase } from '../lib/url';

const links = [
  { href: '/about/', label: '新外研について' },
  { href: '/events/', label: '研究会の一覧' },
  { href: '/history/', label: '沿革' },
  { href: '/bylaws/', label: '会則' },
  { href: '/officers/', label: '役員' },
];
---

<nav class="side-box" aria-labelledby="side-links">
  <h2 class="side-box__title" id="side-links">会の情報</h2>
  <ul class="side-links">
    {links.map((l) => (
      <li><a href={withBase(l.href)}>{l.label}</a></li>
    ))}
  </ul>
</nav>
