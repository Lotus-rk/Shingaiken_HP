---
// 研究会の一覧（1 行目に日付〈曜日〉・種別ラベル・名称、2 行目に会場）。
// トップの「研究会の記録」、次回の研究会の枠の「その後の予定」、研究会一覧ページで共用。
import { eventPath, formatDateDot, jstParts, kindOf, toJstIso, type EventEntry } from '../lib/events';
import { withBase } from '../lib/url';

interface Props {
  events: EventEntry[];
  /** 見出しレベルを持たないリストなので、読み上げ用のラベル */
  label?: string;
  /** 直前の見出しをラベルにするときは、その見出しの id（label と同じ文言を二度読ませないため） */
  labelledby?: string;
}
const { events, label, labelledby } = Astro.props;
---

<ul class="event-list" aria-label={labelledby ? undefined : label} aria-labelledby={labelledby}>
  {
    events.map((e) => {
      const kind = kindOf(e);
      return (
        <li>
          <a class="event-list__item" href={withBase(eventPath(e))}>
            <time class="event-list__date" datetime={toJstIso(e.data.start).slice(0, 10)}>
              {formatDateDot(e.data.start)}
              <span class="event-list__weekday">（{jstParts(e.data.start).weekday}）</span>
            </time>
            <span class="event-list__body">
              <span class={`kind ${kind.className}`}>{kind.label}</span>
              <span class="event-list__title">{e.data.title}</span>
              <span class="event-list__venue">{e.data.venue}</span>
            </span>
          </a>
        </li>
      );
    })
  }
</ul>

<style>
  /* 行の間に細い罫線。左の列に日付、右の列に種別ラベル・名称、その下に会場 */
  .event-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-line);
  }
  .event-list li {
    border-bottom: 1px solid var(--color-line);
  }
  .event-list__item {
    display: grid;
    grid-template-columns: 9.6em minmax(0, 1fr);
    align-items: baseline;
    gap: 2px 16px;
    padding: 16px 4px;
    color: var(--color-text);
    text-decoration: none;
  }
  .event-list__item:hover .event-list__title {
    color: var(--color-main-hover);
    text-decoration: underline;
  }
  .event-list__date {
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    color: var(--color-text-note);
    white-space: nowrap;
  }
  .event-list__weekday {
    font-size: 14px;
  }
  .event-list__body .kind {
    margin-right: 10px;
    vertical-align: 1px;
  }
  .event-list__title {
    font-weight: 500;
    /* 小さい「っ」などで行を始めない。語の切れ目で改行する（対応ブラウザのみ） */
    line-break: strict;
    word-break: auto-phrase;
  }
  .event-list__venue {
    display: block;
    margin-top: 2px;
    font-size: 14px;
    color: var(--color-text-note);
  }
  @media (max-width: 640px) {
    .event-list__item {
      grid-template-columns: minmax(0, 1fr);
      padding: 14px 2px;
    }
  }
</style>
