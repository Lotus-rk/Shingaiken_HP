---
import { site, mainNav } from '../data/site';
import { withBase } from '../lib/url';

const current = Astro.url.pathname;
// 今いるページなら 'page'、その下の階層（例：研究会の個別ページにいるときの「研究会」）なら 'true'
const currentState = (href: string) => {
  const target = withBase(href);
  if (current === target) return 'page';
  if (href === '/' || href.includes('#')) return undefined;
  return current.startsWith(target) ? 'true' : undefined;
};
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-header__brand" href={withBase('/')}>
      <span class="site-header__name">{site.name}</span>
      <span class="site-header__sub">{site.shortName}｜{site.tagline}</span>
    </a>
    <nav aria-label="メインメニュー">
      <ul class="site-header__nav">
        {
          mainNav.map((item) => (
            <li class={item.href === '/' ? 'site-header__home' : undefined}>
              <a href={withBase(item.href)} aria-current={currentState(item.href)}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    background: #fff;
    border-top: 5px solid var(--color-main);
    border-bottom: 1px solid var(--color-line);
  }
  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 24px;
    padding-top: 14px;
    padding-bottom: 14px;
  }
  .site-header__brand {
    display: flex;
    flex-direction: column;
    line-height: 1.35;
    color: var(--color-text);
    text-decoration: none;
  }
  .site-header__name {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 21px;
    letter-spacing: 0.04em;
  }
  .site-header__sub {
    font-size: 13px;
    color: var(--color-text-note);
  }
  .site-header__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 4px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 15px;
    font-weight: 500;
  }
  .site-header__nav a {
    display: block;
    padding: 10px 12px;
    border-radius: 6px;
    color: var(--color-text);
    text-decoration: none;
  }
  .site-header__nav a:hover {
    background: var(--color-bg-tint);
    color: var(--color-main-hover);
  }
  .site-header__nav a[aria-current] {
    color: var(--color-main);
    box-shadow: inset 0 -3px 0 var(--color-main);
    border-radius: 0;
  }
  @media (max-width: 640px) {
    /* スマートフォンでは「ホーム」を隠し、残り 4 項目を 1 行に収める（会の名前のリンクでホームに戻れる） */
    .site-header__home {
      display: none;
    }
    .site-header__nav {
      font-size: 14px;
      margin: 0 -10px;
    }
    .site-header__nav a {
      padding: 8px 10px;
    }
  }
</style>
