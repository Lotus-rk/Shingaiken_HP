---
// トップページ（学会・研究会の公式サイト型）。h1 はヘッダーの会の正式名称（SiteHeader.astro）。
// メニューの下に会の説明の細い帯、その下を 2 列に分け、左に「次回の研究会」と「研究会の記録」、右に会の案内の欄を置く。
// スマートフォンでは 1 列になり、右の欄は下に回る。
import BaseLayout from '../layouts/BaseLayout.astro';
import Banner from '../components/home/Banner.astro';
import NextEvent from '../components/NextEvent.astro';
import Records from '../components/home/Records.astro';
import Sidebar from '../components/Sidebar.astro';
import { site } from '../data/site';
import { absoluteUrl } from '../lib/url';
import { getEvents } from '../lib/events';

const { upcoming, past } = await getEvents();

// 検索エンジン向けの会の情報（WebSite と Organization を同じ @graph に入れる）
const home = absoluteUrl('/', Astro.site);
const sameAs = [site.sns.instagram, site.sns.x, ...(site.sns.peatix ? [site.sns.peatix] : [])];
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${home}#website`,
      name: site.name,
      alternateName: [site.shortName],
      url: home,
      inLanguage: 'ja',
      publisher: { '@id': `${home}#organization` },
    },
    {
      '@type': 'Organization',
      '@id': `${home}#organization`,
      name: site.name,
      alternateName: [site.shortName],
      url: home,
      // ロゴ画像ができたら public/ に置き、ここに logo: absoluteUrl(site.logo, Astro.site) を加える
      foundingDate: site.foundingDate,
      email: site.email,
      address: {
        '@type': 'PostalAddress',
        addressCountry: 'JP',
        addressRegion: site.office.region,
        addressLocality: site.office.locality,
        streetAddress: `${site.office.street} ${site.office.note}`,
        postalCode: site.office.postalCode,
      },
      sameAs,
    },
  ],
};
---

<BaseLayout description={site.description} jsonLd={jsonLd}>
  <Banner />
  <div class="container home">
    <div class="home__main">
      <NextEvent events={upcoming} headingId="next" pastLink={{ href: '/#records', label: '研究会の記録' }} />
      <Records events={past} />
    </div>
    <Sidebar pastCount={past.length} />
  </div>
</BaseLayout>

<style>
  .home {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 40px;
    padding-top: 32px;
    padding-bottom: var(--space-section);
  }
  .home__main {
    display: grid;
    gap: 40px;
    align-content: start;
    min-width: 0;
  }
  @media (max-width: 900px) {
    .home {
      grid-template-columns: minmax(0, 1fr);
      gap: 36px;
      padding-top: 24px;
    }
  }
</style>
