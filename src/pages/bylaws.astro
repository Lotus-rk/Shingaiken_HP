---
// 会則。本文は src/data/bylaws.md に書く（条文を直すときはそのファイルだけを更新する）。
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { Content, frontmatter } from '../data/bylaws.md';

const ready = frontmatter.ready === true;
const title = '会則';
const description = ready
  ? '新しい外国語実践研究会（新外研）の会則です。目的・名称・事業・会員・役員・会計・会議などを定めています。'
  : '新しい外国語実践研究会（新外研）の会則についてのページです。会則の本文は準備ができしだい掲載します。';
---

<BaseLayout title={title} description={description}>
  <PageHeader title={title} />

  <section class="section">
    <div class="container prose">
      {
        ready ? (
          <>
            <p class="bylaws-heading">新しい外国語実践研究会 会則</p>
            <Content />
            {frontmatter.note && <p class="bylaws-meta">{frontmatter.note}</p>}
          </>
        ) : (
          <p class="bylaws-note" role="note">会則は2026年5月4日に施行されました。本文は準備ができしだい掲載します。</p>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .bylaws-note {
    padding: 12px 16px;
    background: var(--color-next-bg);
    border-left: 4px solid var(--color-next-label);
    color: var(--color-text);
  }
  .bylaws-heading {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 18px;
  }
  .bylaws-meta {
    margin-top: 2em;
    text-align: right;
    color: var(--color-text-note);
    font-size: 14px;
  }
</style>
