---
// 研究会の個別ページ。src/content/events/ の 1 ファイルが 1 ページになる（URL はファイル名）。
// 広い画面：左に種別ラベル・題名・本文、右に「開催情報」と「会の情報」の箱。
// スマートフォン：題名 → 開催情報 → 本文 → 会の情報 の順に 1 列で並べる（HTML の並びもこの順。
// 読み上げやキーボード操作の順が見た目と同じになるよう、CSS の order で入れ替えない）。
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import EventFacts from '../../components/events/EventFacts.astro';
import InfoLinks from '../../components/InfoLinks.astro';
import { eventPath, getAllEvents, getEvents, jstParts, kindOf, toJstIso, type EventEntry } from '../../lib/events';
import { site } from '../../data/site';
import { absoluteUrl, withBase } from '../../lib/url';

export async function getStaticPaths() {
  const events = await getAllEvents();
  return events.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

interface Props {
  entry: EventEntry;
}
const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);

const { upcoming } = await getEvents();
const isUpcoming = upcoming.some((e) => e.id === entry.id);
const kind = kindOf(entry);
const fullName = d.subtitle ? `${d.title}――${d.subtitle}` : d.title;

// ---- 構造化データ（schema.org Event ＋ BreadcrumbList） ----
const pageUrl = absoluteUrl(eventPath(entry), Astro.site);
const homeUrl = absoluteUrl('/', Astro.site);
const eventsUrl = absoluteUrl('/events/', Astro.site);

/** 開始が 0:00（日本時間）のものは時刻未定とみなし、日付だけを出す */
const startHasTime = (() => {
  const p = jstParts(d.start);
  return p.hour !== 0 || p.minute !== 0;
})();
const schemaDate = (date: Date) => (startHasTime ? toJstIso(date) : toJstIso(date).slice(0, 10));

/** 「東京都世田谷区深沢4-10-1」を都道府県・市区町村・番地に分ける（分けられなければそのまま） */
function postalAddress(address: string) {
  const m = address.match(/^(東京都|北海道|(?:京都|大阪)府|.{2,3}県)(.+?[市区町村])(.+)$/);
  return m
    ? { '@type': 'PostalAddress', addressRegion: m[1], addressLocality: m[2], streetAddress: m[3], addressCountry: 'JP' }
    : { '@type': 'PostalAddress', streetAddress: address, addressCountry: 'JP' };
}

const place = {
  '@type': 'Place',
  name: d.venue,
  ...(d.venueAddress ? { address: postalAddress(d.venueAddress) } : {}),
};
const virtual = { '@type': 'VirtualLocation', url: d.apply ?? pageUrl };
const location = d.format === 'online' ? virtual : d.format === 'onsite' ? place : [place, virtual];

const attendanceMode = {
  online: 'https://schema.org/OnlineEventAttendanceMode',
  onsite: 'https://schema.org/OfflineEventAttendanceMode',
  hybrid: 'https://schema.org/MixedEventAttendanceMode',
}[d.format];

const offers =
  d.fee && d.apply
    ? [
        { name: '一般', price: d.fee.general },
        ...(d.fee.student !== undefined ? [{ name: '学生', price: d.fee.student }] : []),
      ].map((o) => ({
        '@type': 'Offer',
        name: o.name,
        price: o.price,
        priceCurrency: 'JPY',
        url: d.apply,
        ...(isUpcoming ? { availability: 'https://schema.org/InStock' } : {}),
      }))
    : undefined;

const eventLd = {
  '@type': 'Event',
  '@id': `${pageUrl}#event`,
  name: fullName,
  description: d.summary,
  startDate: schemaDate(d.start),
  ...(d.end ? { endDate: schemaDate(d.end) } : {}),
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: attendanceMode,
  location,
  ...(offers ? { offers } : {}),
  organizer: { '@type': 'Organization', '@id': `${homeUrl}#organization`, name: site.name, url: homeUrl },
  ...(d.speakers.length > 0
    ? {
        performer: d.speakers.map((s) => ({
          '@type': 'Person',
          name: s.name,
          ...(s.affiliation ? { affiliation: { '@type': 'Organization', name: s.affiliation } } : {}),
        })),
      }
    : {}),
  url: pageUrl,
  inLanguage: 'ja',
};

const breadcrumbLd = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'ホーム', item: homeUrl },
    { '@type': 'ListItem', position: 2, name: '研究会', item: eventsUrl },
    { '@type': 'ListItem', position: 3, name: d.title, item: pageUrl },
  ],
};

const jsonLd = { '@context': 'https://schema.org', '@graph': [eventLd, breadcrumbLd] };
---

<BaseLayout title={d.title} description={d.summary} ogType="article" jsonLd={jsonLd}>
  <div class="event-crumbs">
    <Breadcrumbs items={[{ label: '研究会', href: '/events/' }, { label: d.title }]} />
  </div>
  <article class="container event-layout">
    {/* 並び（HTML）：題名 → 開催情報 → 本文 → 会の情報。広い画面では開催情報と会の情報を右の列に置く */}
    <header class="event-head">
      <p class="event-head__kind"><span class={`kind ${kind.className}`}>{kind.label}</span></p>
      <h1 class="page-title">
        {d.title}
        {d.subtitle && <span class="page-title__sub">{d.subtitle}</span>}
      </h1>
    </header>

    <section class="side-box event-info" aria-labelledby="facts-title">
      <h2 class="side-box__title" id="facts-title">開催情報</h2>
      <div class="event-info__body">
        {
          isUpcoming ? (
            d.apply && (
              <p class="event-info__apply">
                <a class="button button--primary" href={d.apply} rel="noopener">
                  Peatix で申し込む
                </a>
              </p>
            )
          ) : (
            <p class="event-info__ended">この研究会は終了しました。</p>
          )
        }
        <EventFacts entry={entry} upcoming={isUpcoming} />
      </div>
    </section>

    <div class="event-body">
      <div class="prose">
        <Content />
      </div>
      {
        d.images.length > 0 && (
          <div class="event-photos">
            <h2 class="visually-hidden">写真</h2>
            {d.images.map((img) => (
              <figure class="event-photos__item">
                <Image src={img.src} alt={img.alt} widths={[480, 720, 960]} sizes="(min-width: 1000px) 720px, 100vw" />
              </figure>
            ))}
          </div>
        )
      }
      <p class="event-body__back">
        <a class="text-link" href={withBase('/events/')}><span aria-hidden="true">‹</span> 研究会一覧へ戻る</a>
      </p>
    </div>

    <div class="event-links">
      <InfoLinks />
    </div>
  </article>
</BaseLayout>

<style>
  /* 広い画面：左の列に題名と本文、右の列に開催情報（題名の行から）と、その下に会の情報 */
  .event-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    grid-template-rows: auto auto 1fr;
    grid-template-areas:
      'head info'
      'body info'
      'body links';
    gap: 0 40px;
    padding-top: 24px;
    padding-bottom: var(--space-section);
  }
  /* パンくずの行の下に、画面の端から端まで細い罫線 */
  .event-crumbs {
    border-bottom: 1px solid var(--color-line);
  }
  .event-head {
    grid-area: head;
    align-self: start;
    margin-bottom: 28px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--color-line);
  }
  .event-head__kind {
    margin: 0 0 6px;
  }
  .event-links {
    grid-area: links;
    align-self: start;
    margin-top: 20px;
  }
  .event-body {
    grid-area: body;
    min-width: 0;
  }
  .event-info {
    grid-area: info;
    align-self: start;
    font-size: 15px;
  }
  .event-info__body {
    padding: 12px;
  }
  .event-info__apply {
    margin: 0 0 8px;
  }
  .event-info__apply .button {
    display: block;
    text-align: center;
  }
  .event-info__ended {
    margin: 0 0 8px;
    padding: 6px 12px;
    background: #f4f5f6;
    border-left: 4px solid var(--color-text-note);
    font-weight: 500;
    color: var(--color-text-sub);
  }
  .event-photos {
    display: grid;
    gap: 24px;
    max-width: var(--width-text);
    margin: 32px 0 0;
  }
  .event-photos__item {
    margin: 0;
  }
  .event-photos__item :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  .event-body__back {
    margin: 32px 0 0;
  }
  /* 1 列のとき：HTML の順（題名 → 開催情報 → 本文 → 会の情報）のまま縦に並べる */
  @media (max-width: 900px) {
    .event-layout {
      display: flex;
      flex-direction: column;
      gap: 28px;
      padding-top: 16px;
    }
    /* 広い画面用の align-self: start を戻し、どの箱も画面の幅いっぱいにする */
    .event-head,
    .event-info,
    .event-links {
      align-self: stretch;
    }
    .event-head {
      margin-bottom: 0;
    }
    .event-links {
      margin-top: 0;
    }
  }
</style>
