---
// 研究会一覧：これからの研究会（トップと同じお知らせの枠。なければ準備中の案内）と、過去の研究会（新しい順）
import BaseLayout from '../../layouts/BaseLayout.astro';
import EventList from '../../components/EventList.astro';
import NextEvent from '../../components/NextEvent.astro';
import PageHeader from '../../components/PageHeader.astro';
import { getEvents } from '../../lib/events';
import { site } from '../../data/site';
import { absoluteUrl } from '../../lib/url';

const { upcoming, past } = await getEvents();

const description =
  '新しい外国語実践研究会（新外研）が開く研究会の一覧です。公開授業研究会、オンライン授業検討会、セミナーなど、これからの研究会と過去の研究会の開催情報・開催報告をご覧いただけます。';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'ホーム', item: absoluteUrl('/', Astro.site) },
    { '@type': 'ListItem', position: 2, name: '研究会', item: absoluteUrl('/events/', Astro.site) },
  ],
};
---

<BaseLayout title="研究会" description={description} jsonLd={jsonLd}>
  <PageHeader
    title="研究会"
    lead={`${site.shortName}が開く研究会のご案内です。各研究会のページでは、開催情報と開催後の報告をご覧いただけます。`}
  />

  <div class="container events-page">
    <NextEvent
      events={upcoming}
      title="これからの研究会"
      headingId="upcoming-title"
      othersTitle="その後の予定"
      pastLink={{ href: '/events/#past-title', label: '過去の研究会' }}
    />

    <section aria-labelledby="past-title">
      <h2 class="section-title" id="past-title">過去の研究会</h2>
      {past.length > 0 ? <EventList events={past} label="過去の研究会（新しい順）" /> : <p>まだありません。</p>}
    </section>
  </div>
</BaseLayout>

<style>
  .events-page {
    display: grid;
    gap: 44px;
    padding-top: 32px;
    padding-bottom: var(--space-section);
  }
  @media (max-width: 640px) {
    .events-page {
      gap: 36px;
      padding-top: 24px;
    }
  }
</style>
